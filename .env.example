NLP_PROVIDER_CHAIN=sumopod,qwen
NLP_PROVIDER=sumopod
NLP_LOCAL_FALLBACK=false
NLP_PROVIDER_TIMEOUT_SECONDS=8

# Qwen melalui Alibaba Cloud Model Studio/DashScope.
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Sumopod memakai API OpenAI-compatible. Dapat dijadikan provider utama atau fallback.
SUMOPOD_API_KEY=
SUMOPOD_MODEL=glm-5
SUMOPOD_BASE_URL=https://ai.sumopod.com/v1
SUMOPOD_TIMEOUT_SECONDS=30

# Supabase opsional; service role hanya boleh digunakan backend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TIMEOUT_SECONDS=5
# Simpan nama dan keluhan agar kasus dapat diverifikasi pakar. Set false bila kebijakan privasi melarangnya.
SUPABASE_STORE_DIAGNOSIS_DETAILS=true

RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_SALT=CHANGE_WITH_A_LONG_RANDOM_VALUE

# Database: gunakan mysql untuk XAMPP lokal atau supabase untuk deployment.
DATABASE_BACKEND=supabase
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=iphone_diagnosis
MYSQL_USER=iphone_app
MYSQL_PASSWORD=
MYSQL_CONNECT_TIMEOUT_SECONDS=5

# Gunakan nilai acak panjang. SESSION_COOKIE_SECURE=true hanya ketika HTTPS.
ADMIN_SESSION_SECRET=CHANGE_WITH_A_LONG_RANDOM_VALUE
SESSION_COOKIE_SECURE=false
TRAINING_TIMEOUT_SECONDS=3600
